---
import SectionHeading from "./SectionHeading.astro";
import science from "../data/science.json";
import { ScanSearch, Grid3x3 as Grid3X3, ArrowUpRight } from "@lucide/astro";
---

<section id="overview" class="section container">
  <div class="headline-stats" aria-label="Manuscript dataset statistics">
    {science.statistics.slice(0, 4).map((s) => (
      <div class="stat">
        <strong>{s.display}</strong>
        <span>{s.label}</span>
      </div>
    ))}
  </div>
  <SectionHeading
    number="01"
    label="The dataset"
    title="From seeing a scene to understanding its inhabitants."
  />
  <div class="overview-layout">
    <div class="overview-intro">
      <p class="lead">
        Marine perception needs more than a category label or a single count.
      </p>
      <p>
        Nereus connects object-level biological detail with spatially grounded
        evidence. It supports two complementary task families for the
        challenging visual conditions of the underwater world.
      </p>
      <a class="text-link" href="#construction">
        How Nereus is built <ArrowUpRight size={17} />
      </a>
    </div>
    <div class="task-overview">
      <article>
        <ScanSearch size={28} />
        <div>
          <span class="micro-label">Task family 01</span>
          <h3>Fine-grained attributes</h3>
          <p>
            Identity, structure, appearance, condition and interaction, grounded
            at the organism level.
          </p>
        </div>
      </article>
      <article>
        <Grid3X3 size={28} />
        <div>
          <span class="micro-label">Task family 02</span>
          <h3>Grounded counting</h3>
          <p>
            How many, where, under what visibility, and with what density
            evidence.
          </p>
        </div>
      </article>
    </div>
  </div>
  <div class="source-distribution">
    <div class="label-line">
      <h3>A shared view across four sources</h3>
      <span class="source-note">Figure 3 · p. 4</span>
    </div>
    <div
      class="distribution-bar"
      role="img"
      aria-label="Source image counts: FathomNet 67,248; iNaturalist 13,480; IOCfish5K 5,637; CoralVQA 2,190"
    >
      {science.sources.map((s) => (
        <span style={`flex:${s.count};background:${s.color}`}></span>
      ))}
    </div>
    <div class="distribution-legend">
      {science.sources.map((s) => (
        <div>
          <i style={`background:${s.color}`}></i>
          <span>{s.name}</span>
          <strong>{s.count.toLocaleString("en-US")}</strong>
        </div>
      ))}
    </div>
  </div>
  <details class="version-note" id="version-note">
    <summary>Dataset version and statistics note</summary>
    <p>
      All headline numbers describe the supplied manuscript, not a freshly
      recounted release. It additionally reports 136K objects, 1,515 genera, 65K
      points and 67K grounded counting QA pairs (abstract, p. 1). The point
      total conflicts with IOCfish5K's{" "}
      <a href="https://github.com/GuoleiSun/Indiscernible-Object-Counting">
        659,024 source annotations
      </a>
      ; the organism-group totals in Figure 3 also do not reconcile with 136K.
      These totals are pending author reconciliation and are not presented as
      verified release counts.
    </p>
  </details>
</section>
