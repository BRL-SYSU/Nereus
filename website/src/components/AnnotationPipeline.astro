---
import SectionHeading from "./SectionHeading.astro";
import {
  ScanSearch,
  BookOpen,
  MessagesSquare,
  Scale,
  BadgeCheck,
  Crosshair,
  Grid3x3 as Grid3X3,
  Eye,
  Flame,
  MessageCircle,
} from "@lucide/astro";
const attributes = [
  {
    Icon: ScanSearch,
    title: "Locate",
    body: "Object localization and contextual crops.",
  },
  { Icon: BookOpen, title: "Ground", body: "Taxonomic knowledge priors." },
  {
    Icon: MessagesSquare,
    title: "Discuss",
    body: "Independent models compare answers.",
  },
  {
    Icon: Scale,
    title: "Arbitrate",
    body: "Uncertain cases reach a larger model.",
  },
  {
    Icon: BadgeCheck,
    title: "Review",
    body: "Calibrated quality scoring and expert checks.",
  },
];
const counting = [
  {
    Icon: Crosshair,
    title: "Count",
    body: "Existing IOCfish5K point annotations.",
  },
  {
    Icon: Grid3X3,
    title: "Locate",
    body: "Semantic regions and spatial grids.",
  },
  {
    Icon: Eye,
    title: "Characterize",
    body: "Clear, ambiguous and camouflaged states.",
  },
  {
    Icon: Flame,
    title: "Aggregate",
    body: "Point-derived density and local hotspots.",
  },
  {
    Icon: MessageCircle,
    title: "Question",
    body: "Grounded QA with spatial evidence.",
  },
];
---

<section id="construction" class="section container">
  <SectionHeading
    number="04"
    label="Dataset construction"
    title="Built from evidence. Refined through review."
    description="Two complementary annotation pipelines connect biological knowledge, visual evidence and structured supervision."
  />
  <div class="pipeline">
    <div class="pipeline-label">
      <span>01</span>
      <h3>Object attributes</h3>
      <small>Section 4.1 · pp. 6–7</small>
    </div>
    <ol>
      {attributes.map(({ Icon, title, body }) => (
        <li>
          <Icon size={24} />
          <h4>{title}</h4>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </div>
  <div class="pipeline counting-pipeline">
    <div class="pipeline-label">
      <span>02</span>
      <h3>Grounded counting</h3>
      <small>Section 4.2 · pp. 6–7</small>
    </div>
    <ol>
      {counting.map(({ Icon, title, body }) => (
        <li>
          <Icon size={24} />
          <h4>{title}</h4>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </div>
  <div class="quality-note">
    <div>
      <span class="micro-label">Annotation quality</span>
      <h3>Model assistance, human calibration.</h3>
    </div>
    <div>
      <p>
        Qwen3-VL-8B and InternVL3-8B discuss attribute annotations;
        low-confidence cases go to Qwen2.5-VL-72B. GPT-4o quality assessment is
        calibrated by three marine-biology master's students, with expert
        arbitration for low-scoring test annotations.
      </p>
      <p class="source-note">
        Reported quality: 9.26/10 on 200 sampled training images and 9.14/10 on
        test annotations. These are quality ratings, not percentage accuracy.
        Sections 3.2 and 4.1; Appendix A.1.
      </p>
    </div>
  </div>
</section>
