---
import science from "../data/science.json";
import { asset } from "../lib/paths";
import { ArrowDown } from "@lucide/astro";
---

<section class="hero" aria-labelledby="hero-title">
  <img
    class="hero-image"
    src={asset("assets/counting/0000-1920.webp")}
    srcset={`${asset("assets/counting/0000-640.webp")} 640w, ${asset("assets/counting/0000-1280.webp")} 1280w, ${asset("assets/counting/0000-1920.webp")} 1920w`}
    sizes="100vw"
    width="1920"
    height="1080"
    alt="IOCfish5K sample 0000: fish at different distances above a coral reef"
    fetchpriority="high"
  />
  <div class="hero-shade"></div>
  <div class="container hero-content">
    <p class="hero-venue">
      <span></span>
      {science.venue}
    </p>
    <h1 id="hero-title">
      Nereus<span>.</span>
    </h1>
    <p class="hero-title">
      A Large-Scale Underwater Dataset for Fine-Grained Attribute Understanding
      and Grounded Counting Perception
    </p>
  </div>
  <a
    class="hero-scroll"
    href="#publication"
    aria-label="Meet the authors"
    title="Meet the authors"
  >
    <ArrowDown size={23} />
  </a>
  <div class="container hero-bottom">
    <span>
      Biological attributes <span class="hero-separator">/</span> Spatial
      evidence
    </span>
    <span>
      IOCfish5K · sample 0000 · <a href="#provenance">Image credits</a>
    </span>
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>(".hero")!;
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>(".publication-header > *"),
  );
  const motion = matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries)
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          reveal.unobserve(entry.target);
        }
    },
    { rootMargin: "0px 0px -48px 0px", threshold: 0.15 },
  );
  groups.forEach((group) => {
    group.classList.add("reveal-group");
    reveal.observe(group);
  });
  function paint() {
    frame = 0;
    const rect = hero.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1, -rect.top / rect.height));
    hero.style.setProperty(
      "--hero-shift",
      motion.matches ? "0px" : `${progress * 65}px`,
    );
    hero.style.setProperty(
      "--hero-opacity",
      String(motion.matches ? 1 : 1 - progress * 0.75),
    );
  }
  function schedule() {
    if (!frame) frame = requestAnimationFrame(paint);
  }
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  motion.addEventListener("change", schedule);
  document
    .querySelector(".publication-header")
    ?.addEventListener("focusin", () =>
      groups.forEach((g) => g.classList.add("revealed")),
    );
  paint();
</script>
