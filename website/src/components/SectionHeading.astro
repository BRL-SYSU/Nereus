---
interface Props {
  number: string;
  label: string;
  title: string;
  description?: string;
}
const { number, label, title, description } = Astro.props;
---

<div class="section-heading">
  <div class="eyebrow">
    <span>{number}</span>
    {label}
  </div>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</div>
