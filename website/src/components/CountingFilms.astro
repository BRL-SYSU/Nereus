---
import { RotateCcw, Maximize, Download } from "@lucide/astro";
import { asset } from "../lib/paths";
const films = [
  {
    id: "region",
    name: "Region-aware counting",
    short: "Regions",
    question: "How many, and where?",
    description:
      "Point annotations connect exact counts to spatial cells and semantic scene regions.",
    sample: "0000",
  },
  {
    id: "camouflage",
    name: "Camouflage-state counting",
    short: "Camouflage",
    question: "What is hiding in plain sight?",
    description:
      "Clear, ambiguous and highly camouflaged annotations separate counting difficulty from the total count.",
    sample: "0001",
  },
  {
    id: "density",
    name: "Density-hotspot reasoning",
    short: "Density",
    question: "What connects fish density to habitat?",
    description:
      "Localized density responses lead to visual evidence, relative-depth annotations and interpretations of how fish interact with their environment.",
    sample: "0001 + 0003",
  },
];
---

<div class="counting-films" id="counting-films">
  <div class="film-tabs" role="tablist" aria-label="Counting task films">
    {films.map((film, i) => (
      <button
        id={`film-tab-${film.id}`}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        aria-controls={`film-panel-${film.id}`}
        tabindex={i === 0 ? 0 : -1}
        data-film={film.id}
      >
        <span class="film-number">0{i + 1}</span>
        <span class="film-tab-name">{film.name}</span>
        <span class="film-tab-short">{film.short}</span>
      </button>
    ))}
  </div>
  {films.map((film, i) => (
    <div
      id={`film-panel-${film.id}`}
      class="film-panel"
      role="tabpanel"
      aria-labelledby={`film-tab-${film.id}`}
      hidden={i !== 0}
      tabindex="0"
    >
      <div class="film-intro">
        <h3>{film.question}</h3>
        <p>{film.description}</p>
      </div>
      <div class="film-stage">
        <video
          id={`film-${film.id}`}
          class="counting-film"
          controls
          muted
          playsinline
          loop
          preload="none"
          poster={asset(`assets/videos/${film.id}-poster.webp`)}
          width="1280"
          height="720"
          aria-label={`${film.name}: annotated dataset visualization`}
        >
          <source
            src={asset(`assets/videos/${film.id}.mp4`)}
            type="video/mp4"
          />
          <track
            kind="captions"
            src={asset(`assets/videos/${film.id}.vtt`)}
            srclang="en"
            label="English"
          />
          <a href={asset(`assets/videos/${film.id}.mp4`)}>
            Download {film.name}
          </a>
        </video>
      </div>
      <div class="film-footer">
        <p>
          <strong>Annotation visualization</strong>
          <span>IOCfish5K {film.sample} + Nereus annotations</span>
        </p>
        <div class="film-actions">
          <button
            class="icon-button film-replay"
            aria-label="Replay film"
            title="Replay film"
          >
            <RotateCcw size={18} />
          </button>
          <button
            class="icon-button film-fullscreen"
            aria-label="Full screen"
            title="Full screen"
          >
            <Maximize size={18} />
          </button>
          <a
            class="icon-button"
            href={asset(`assets/videos/${film.id}.mp4`)}
            download
            aria-label={`Download ${film.name} video`}
            title="Download MP4"
          >
            <Download size={18} />
          </a>
        </div>
      </div>
      <p class="film-status" role="status" hidden></p>
      <details class="film-transcript">
        <summary>Video transcript</summary>
        <p>
          {film.id === "region"
            ? "Sample 0000 contains 90 annotated fish. Its densest grid cell is the top-right, with 31. Semantic memberships include 82 fish in open water and 5 in reef / rock. Grid partitions and semantic memberships are different counting views; semantic regions can overlap."
            : film.id === "camouflage"
              ? "Sample 0001 contains 270 annotated fish: 134 clear, 130 ambiguous and 6 highly camouflaged. Point colors follow the dataset visibility labels; close-ups show the corresponding image evidence."
              : "Sample 0001, hotspot 1: open blue water without visible bottom structure. The source relative-depth tag is relatively deeper. Annotation interpretation: open swimming space may support schooling or temporary aggregation. Sample 0003, hotspot 1: branching coral with fish nearby. The source relative-depth tag is relatively shallower. Annotation interpretation: reef structure may offer shelter and food, relating to nearby aggregation. Dashed outlines mark source context patches; camera crops are presentation choices. Depth tags are relative, not measured distances. These ecological interpretations are annotation hypotheses, not verified causes or observed feeding behavior."}
        </p>
        {film.id === "density" && (
          <a href={asset("assets/videos/density-evidence.json")} download>
            Source evidence and annotation excerpts
          </a>
        )}
      </details>
    </div>
  ))}
  <p class="film-credit">
    Imagery: Guolei Sun et al., IOCfish5K &middot; CC BY-NC 4.0. Animated
    overlays and crops from Nereus annotations. Not model predictions.
  </p>
</div>
<script>
  const root = document.querySelector<HTMLElement>("#counting-films")!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  const videos = [...root.querySelectorAll<HTMLVideoElement>("video")];
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let selected = 0;
  let introduced = false;
  function status(index: number, message: string) {
    const element = panels[index].querySelector<HTMLElement>(".film-status")!;
    element.textContent = message;
    element.hidden = !message;
  }
  async function play(index: number) {
    try {
      await videos[index].play();
      status(index, "");
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      if (!panels[index].hidden)
        status(
          index,
          "Playback has not started. Use the video play control or download the MP4.",
        );
    }
  }
  function select(index: number, focus = false) {
    videos.forEach((video, i) => {
      video.pause();
      if (i !== index && video.readyState) video.currentTime = 0;
      panels[i].hidden = i !== index;
      tabs[i].setAttribute("aria-selected", String(i === index));
      tabs[i].tabIndex = i === index ? 0 : -1;
    });
    selected = index;
    introduced = true;
    if (focus) tabs[index].focus();
    if (!motion.matches) void play(index);
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(i));
    tab.addEventListener("keydown", (event) => {
      let target: number | undefined;
      if (event.key === "ArrowRight") target = (i + 1) % tabs.length;
      if (event.key === "ArrowLeft")
        target = (i + tabs.length - 1) % tabs.length;
      if (event.key === "Home") target = 0;
      if (event.key === "End") target = tabs.length - 1;
      if (target !== undefined) {
        event.preventDefault();
        select(target, true);
      }
    });
  });
  videos.forEach((video, i) => {
    video.addEventListener("play", () => {
      videos.forEach((other) => {
        if (other !== video) other.pause();
      });
    });
    video.addEventListener("playing", () => status(i, ""));
    video.addEventListener("error", () =>
      status(
        i,
        "This video could not load. Retry with the replay button or download the MP4.",
      ),
    );
    video
      .querySelector("source")
      ?.addEventListener("error", () =>
        status(
          i,
          "This video could not load. Retry with the replay button or download the MP4.",
        ),
      );
    panels[i].querySelector(".film-replay")!.addEventListener("click", () => {
      if (
        video.error ||
        video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE
      )
        video.load();
      video.currentTime = 0;
      void play(i);
    });
    panels[i]
      .querySelector(".film-fullscreen")!
      .addEventListener("click", async () => {
        try {
          if (video.requestFullscreen) await video.requestFullscreen();
          else if ("webkitEnterFullscreen" in video)
            (
              video as HTMLVideoElement & { webkitEnterFullscreen: () => void }
            ).webkitEnterFullscreen();
          else status(i, "Full screen is unavailable in this browser.");
        } catch {
          status(
            i,
            "Full screen is unavailable in this browser. The MP4 can be opened separately.",
          );
        }
      });
  });
  const observer = new IntersectionObserver(
    ([entry]) => {
      if (!entry.isIntersecting) videos.forEach((video) => video.pause());
      else if (!introduced) {
        introduced = true;
        if (!motion.matches && !document.hidden) void play(selected);
      }
    },
    { threshold: 0.25 },
  );
  observer.observe(root);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) videos.forEach((video) => video.pause());
  });
  motion.addEventListener("change", () => {
    if (motion.matches) videos.forEach((video) => video.pause());
  });
</script>
