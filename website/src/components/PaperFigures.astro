---
import { Expand, X } from "@lucide/astro";
import { asset } from "../lib/paths";
const figures = [
  {
    id: "motivation",
    title: "Motivation",
    number: 2,
    page: 2,
    width: 2416,
    height: 1112,
    alt: "Nereus motivation: gaps in fine-grained underwater perception connect to object attributes, grounded counting and degradation annotations.",
    caption:
      "Motivation of Nereus. The figure contrasts application needs in underwater scenarios with the limitations of current underwater understanding resources, motivating a dataset that jointly supports Fine-Grained Object Attribute Understanding, Grounded Counting Perception, and degradation-aware analysis.",
  },
  {
    id: "pipeline",
    title: "Pipeline",
    number: 4,
    page: 5,
    width: 2408,
    height: 952,
    alt: "Nereus construction pipeline: multi-model attribute discussion and arbitration on the left; region-aware, camouflage-aware and density-hotspot counting supervision on the right.",
    caption:
      "Construction pipeline of Nereus. The pipeline integrates heterogeneous underwater resources. For Fine-Grained Object Attribute Understanding, object-centered crops, localization context, and biological knowledge priors are used to generate structured attribute annotations through multi-model discussion and arbitration. For Grounded Counting Perception, point annotations are converted into semantic-region counts, grid statistics, camouflage labels, density maps, and hotspot evidence, which are further transformed into region-aware, camouflage-aware, and density-reasoning QA pairs.",
  },
];
---

<section
  id="paper-figures"
  class="paper-figures container"
  aria-label="Motivation and construction pipeline"
>
  {figures.map((f) => (
    <figure id={`paper-${f.id}`} class="paper-figure">
      <div class="paper-figure-heading">
        <h2>{f.title}</h2>
        <span class="source-note">
          Figure {f.number} · p. {f.page}
        </span>
      </div>
      <button
        class="paper-figure-open"
        data-title={f.title}
        data-full={asset(`assets/paper/${f.id}.webp`)}
        aria-label={`Enlarge ${f.title} figure`}
        title={`Enlarge ${f.title} figure`}
      >
        <img
          src={asset(`assets/paper/${f.id}-1440.webp`)}
          srcset={`${asset(`assets/paper/${f.id}-1440.webp`)} 1440w, ${asset(`assets/paper/${f.id}.webp`)} ${f.width}w`}
          sizes="(max-width: 760px) 92vw, 1200px"
          width={f.width}
          height={f.height}
          alt={f.alt}
          loading="lazy"
          decoding="async"
        />
        <span class="paper-expand" aria-hidden="true">
          <Expand size={20} />
        </span>
      </button>
      <figcaption>
        <strong>Figure {f.number}.</strong> {f.caption}
      </figcaption>
    </figure>
  ))}
  <dialog class="paper-dialog" aria-labelledby="paper-dialog-title">
    <div class="paper-dialog-header">
      <h2 id="paper-dialog-title"></h2>
      <button
        class="icon-button paper-dialog-close"
        aria-label="Close enlarged figure"
        title="Close"
      >
        <X size={22} />
      </button>
    </div>
    <div class="paper-dialog-scroll" tabindex="0" aria-label="Enlarged figure">
      <img
        id="paper-dialog-image"
        src={asset("assets/paper/motivation.webp")}
        width="2416"
        height="1112"
        alt="Motivation of Nereus"
        loading="lazy"
      />
    </div>
  </dialog>
</section>

<style>
  .paper-figures {
    padding-block: 0 56px;
  }
  .paper-figure {
    position: relative;
    margin: 0;
    padding-block: 40px;
    border-top: 1px solid #d4e2df;
  }
  .paper-figure-heading {
    padding-right: 52px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .paper-figure-heading h2 {
    margin: 0;
    font-size: 30px;
  }
  .paper-figure-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: white;
    cursor: zoom-in;
  }
  .paper-figure-open img {
    display: block;
    width: 100%;
    height: auto;
  }
  .paper-expand {
    position: absolute;
    right: 0;
    top: 40px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: #fff;
    color: #173b3b;
    border: 1px solid #d4e2df;
    border-radius: 4px;
  }
  figcaption {
    margin-top: 20px;
    color: #526e6c;
    font-size: 14px;
    line-height: 1.7;
    max-width: 100%;
  }
  .paper-dialog {
    width: min(96vw, 1800px);
    max-width: 96vw;
    max-height: 94dvh;
    padding: 20px;
    border: 1px solid #d4e2df;
    border-radius: 6px;
    background: white;
    color: #173b3b;
  }
  .paper-dialog::backdrop {
    background: #122c32bd;
  }
  .paper-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }
  .paper-dialog-header h2 {
    margin: 0;
    font-size: 24px;
  }
  .paper-dialog-scroll {
    overflow: auto;
    max-height: 78dvh;
    overscroll-behavior: contain;
  }
  .paper-dialog-scroll img {
    display: block;
    width: 100%;
    min-width: 1100px;
    max-width: none;
    height: auto;
  }
  @media (max-width: 760px) {
    .paper-figure-heading h2 {
      font-size: 25px;
    }
    .paper-dialog {
      padding: 12px;
    }
    figcaption {
      font-size: 13px;
    }
  }
</style>
<script>
  const dialog = document.querySelector<HTMLDialogElement>(".paper-dialog")!;
  const image = document.querySelector<HTMLImageElement>(
    "#paper-dialog-image",
  )!;
  const title = document.querySelector<HTMLElement>("#paper-dialog-title")!;
  let opener: HTMLButtonElement | null = null;
  let previousOverflow = "";
  document
    .querySelectorAll<HTMLButtonElement>(".paper-figure-open")
    .forEach((button) => {
      button.addEventListener("click", () => {
        opener = button;
        title.textContent = button.dataset.title!;
        image.src = button.dataset.full!;
        image.alt = button.querySelector("img")!.alt;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        dialog.showModal();
        dialog.querySelector(".paper-dialog-scroll")!.scrollLeft = 0;
      });
    });
  dialog
    .querySelector(".paper-dialog-close")!
    .addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const r = dialog.getBoundingClientRect();
    if (
      event.clientX < r.left ||
      event.clientX > r.right ||
      event.clientY < r.top ||
      event.clientY > r.bottom
    )
      dialog.close();
  });
  dialog.addEventListener("close", () => {
    document.body.style.overflow = previousOverflow;
    opener?.focus({ preventScroll: true });
  });
</script>
