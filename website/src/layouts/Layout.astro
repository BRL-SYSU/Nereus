---
import "../styles/global.css";
import "../styles/publication.css";
import "@fontsource-variable/manrope";
import "@fontsource/dm-serif-display/400.css";
import { WavesHorizontal as Waves, ArrowUpRight, Menu, X } from "@lucide/astro";
import { asset } from "../lib/paths";
const { title = "Nereus | Fine-Grained Underwater Perception" } = Astro.props;
const description =
  "Nereus: fine-grained biological attributes and grounded counting for underwater perception. NeurIPS 2026 Datasets & Benchmarks.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#146b82" />
    <link rel="canonical" href="https://brl-sysu.github.io/Nereus/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://brl-sysu.github.io/Nereus/" />
    <meta
      property="og:image"
      content="https://brl-sysu.github.io/Nereus/assets/counting/0000-1280.webp"
    />
    <link rel="icon" type="image/png" href={asset("assets/favicon.png")} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="nav-inner">
        <a class="wordmark" href={asset("")} aria-label="Nereus home">
          <Waves size={25} stroke-width={1.6} />
          Nereus<span class="wordmark-dot">.</span>
        </a>
        <button
          class="menu-toggle icon-button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="main-nav"
        >
          <Menu class="menu-open" size={23} />
          <X class="menu-close" size={23} />
        </button>
        <nav id="main-nav" aria-label="Main navigation">
          <a href="#abstract">Abstract</a>
          <a href="#overview">Overview</a>
          <a href="#attributes">Attributes</a>
          <a href="#counting">Counting</a>
          <a href="#benchmarks">Benchmarks</a>
          <a href="#resources">Resources</a>
          <a class="nav-github" href="https://github.com/BRL-SYSU/Nereus">
            GitHub
            <ArrowUpRight size={16} />
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <a class="wordmark" href="#main">
          <Waves size={25} />
          Nereus.
        </a>
        <p>A closer look at life underwater.</p>
        <a href="#main" class="text-link">
          Back to top ↑
        </a>
      </div>
      <div class="container footer-bottom">
        <span>NeurIPS 2026 · Datasets & Benchmarks</span>
        <span>
          IOCfish5K imagery: Guolei Sun et al. ·{" "}
          <a href="https://creativecommons.org/licenses/by-nc/4.0/">
            CC BY-NC 4.0
          </a>
        </span>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#main-nav");
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") !== "true";
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute(
          "aria-label",
          open ? "Close navigation" : "Open navigation",
        );
        nav?.classList.toggle("is-open", open);
      });
      nav?.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => {
          button?.setAttribute("aria-expanded", "false");
          button?.setAttribute("aria-label", "Open navigation");
          nav.classList.remove("is-open");
        }),
      );
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          button?.setAttribute("aria-expanded", "false");
          button?.setAttribute("aria-label", "Open navigation");
          nav?.classList.remove("is-open");
        }
      });
    </script>
  </body>
</html>
